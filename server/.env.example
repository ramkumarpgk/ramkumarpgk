PORT=4000
# Shared secret the mobile app sends in the X-Api-Key header
API_KEY=change-me-to-a-long-random-string

# Any SMTP provider works. Examples:
#   Gmail (needs an App Password):     smtp.gmail.com  587
#   Outlook.com / Microsoft 365:       smtp.office365.com 587
#   SendGrid / Mailgun / Amazon SES / Postmark also work
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=family.calendar@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=family.calendar@gmail.com
MAIL_FROM_NAME=Our Family Calendar

# DATA_FILE=./data/db.json
